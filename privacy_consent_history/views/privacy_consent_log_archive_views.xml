<odoo>
    <record id="consent_log_archive_list" model="ir.ui.view">
        <field name="name">Consent Log Archive List</field>
        <field name="model">privacy.consent.log.archive</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="answer_date" />
                <field name="partner_name" />
                <field name="activity_name" />
                <field name="answer" />
                <field name="source" />
                <field name="archive_date" />
                <field name="expiry_date" />
            </list>
        </field>
    </record>
    <record id="consent_log_archive_form" model="ir.ui.view">
        <field name="name">Consent Log Archive Form</field>
        <field name="model">privacy.consent.log.archive</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group name="subject">
                            <field name="partner_name" />
                            <field name="partner_email" />
                            <field name="partner_vat" />
                            <field name="activity_name" />
                            <field name="related_document" />
                        </group>
                        <group name="answer">
                            <field name="answer" />
                            <field name="answer_date" />
                            <field name="source" />
                            <field name="filled_by" />
                            <field name="filled_by_role" />
                            <field name="recorded_by" />
                            <field name="ip_address" />
                            <field name="user_agent" />
                        </group>
                        <group name="collection">
                            <field name="collection_method" />
                            <field name="collection_date" />
                            <field name="note" />
                        </group>
                        <group name="retention">
                            <field name="archive_date" />
                            <field name="expiry_date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="consent_log_archive_search" model="ir.ui.view">
        <field name="name">Consent Log Archive Search</field>
        <field name="model">privacy.consent.log.archive</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_name" />
                <field name="partner_email" />
                <field name="partner_vat" />
                <field name="activity_name" />
                <group name="groupby">
                    <filter
                        name="partner_name_groupby"
                        string="Subject"
                        context="{'group_by': 'partner_name'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="consent_log_archive_action" model="ir.actions.act_window">
        <field name="name">Consent Log Archive</field>
        <field name="res_model">privacy.consent.log.archive</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
