<odoo>
    <record id="consent_log_list" model="ir.ui.view">
        <field name="name">Consent Log List</field>
        <field name="model">privacy.consent.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Date" />
                <field name="partner_id" />
                <field name="activity_id" />
                <field name="answer" />
                <field name="confirmed" optional="hide" />
                <field name="source" />
                <field name="filled_by_partner_id" optional="show" />
                <field name="filled_by_role" optional="show" />
                <field name="user_id" optional="hide" />
                <field name="collection_method_id" optional="show" />
                <field name="collection_date" optional="hide" />
                <field name="ip_address" optional="hide" />
            </list>
        </field>
    </record>
    <record id="consent_log_form" model="ir.ui.view">
        <field name="name">Consent Log Form</field>
        <field name="model">privacy.consent.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group name="answer">
                            <field name="partner_id" />
                            <field name="activity_id" />
                            <field name="consent_id" />
                            <field name="answer" />
                            <field name="confirmed" />
                            <field name="create_date" string="Date" />
                        </group>
                        <group name="author">
                            <field name="source" />
                            <field name="filled_by_partner_id" />
                            <field name="filled_by_role" />
                            <field name="user_id" />
                            <field name="ip_address" />
                            <field name="user_agent" />
                        </group>
                        <group name="collection">
                            <field name="collection_method_id" />
                            <field name="collection_date" />
                            <field name="note" />
                        </group>
                        <group name="document" invisible="not res_model">
                            <field name="res_model" />
                            <field name="res_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="consent_log_search" model="ir.ui.view">
        <field name="name">Consent Log Search</field>
        <field name="model">privacy.consent.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="activity_id" />
                <field name="consent_id" />
                <filter
                    string="Given"
                    name="given"
                    domain="[('answer', '=', 'given')]"
                />
                <filter
                    string="Refused"
                    name="refused"
                    domain="[('answer', '=', 'refused')]"
                />
                <separator />
                <filter
                    string="Not confirmed"
                    name="not_confirmed"
                    domain="[('confirmed', '=', False)]"
                />
                <group name="groupby">
                    <filter
                        name="partner_id_groupby"
                        string="Subject"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="activity_id_groupby"
                        string="Activity"
                        context="{'group_by': 'activity_id'}"
                    />
                    <filter
                        name="source_groupby"
                        string="Source"
                        context="{'group_by': 'source'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="consent_log_action" model="ir.actions.act_window">
        <field name="name">Consent Log</field>
        <field name="res_model">privacy.consent.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
