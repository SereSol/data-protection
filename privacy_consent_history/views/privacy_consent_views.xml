<odoo>
    <record id="consent_form" model="ir.ui.view">
        <field name="name">Privacy Consent Form: collection and log</field>
        <field name="model">privacy.consent</field>
        <field name="inherit_id" ref="privacy_consent.consent_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <field name="accepted_changed" invisible="1" />
                <field name="collection_note_required" invisible="1" />
                <separator name="collection" string="How it was collected" />
                <group name="collection">
                    <group>
                        <field
                            name="collection_method_id"
                            readonly="not accepted_changed"
                            required="accepted_changed"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="collection_date"
                            readonly="not accepted_changed"
                            required="accepted_changed"
                        />
                    </group>
                    <group>
                        <field
                            name="collection_note"
                            readonly="not accepted_changed"
                            required="accepted_changed and collection_note_required"
                        />
                        <field
                            name="collection_attachment_ids"
                            widget="many2many_binary"
                            invisible="not accepted_changed"
                        />
                    </group>
                </group>
                <separator name="log" string="Answer log" />
                <field name="log_ids" readonly="1">
                    <list>
                        <field name="create_date" string="Date" />
                        <field name="answer" />
                        <field name="source" />
                        <field name="filled_by_partner_id" />
                        <field name="filled_by_role" />
                        <field name="collection_method_id" />
                        <field name="confirmed" optional="hide" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
