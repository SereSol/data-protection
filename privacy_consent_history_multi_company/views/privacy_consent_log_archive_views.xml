<odoo>
    <record id="consent_log_archive_list" model="ir.ui.view">
        <field name="name">Consent Log Archive List: company</field>
        <field name="model">privacy.consent.log.archive</field>
        <field
            name="inherit_id"
            ref="privacy_consent_history.consent_log_archive_list"
        />
        <field name="arch" type="xml">
            <field name="activity_name" position="after">
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </field>
        </field>
    </record>
    <record id="consent_log_archive_form" model="ir.ui.view">
        <field name="name">Consent Log Archive Form: company</field>
        <field name="model">privacy.consent.log.archive</field>
        <field
            name="inherit_id"
            ref="privacy_consent_history.consent_log_archive_form"
        />
        <field name="arch" type="xml">
            <field name="activity_name" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
        </field>
    </record>
    <record id="consent_log_archive_search" model="ir.ui.view">
        <field name="name">Consent Log Archive Search: company</field>
        <field name="model">privacy.consent.log.archive</field>
        <field
            name="inherit_id"
            ref="privacy_consent_history.consent_log_archive_search"
        />
        <field name="arch" type="xml">
            <field name="activity_name" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
            <filter name="partner_name_groupby" position="before">
                <filter
                    name="company_id_groupby"
                    string="Company"
                    context="{'group_by': 'company_id'}"
                    groups="base.group_multi_company"
                />
            </filter>
        </field>
    </record>
</odoo>
