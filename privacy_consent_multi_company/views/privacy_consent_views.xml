<odoo>
    <record id="consent_form" model="ir.ui.view">
        <field name="name">Privacy Consent Form: company</field>
        <field name="model">privacy.consent</field>
        <field name="inherit_id" ref="privacy_consent.consent_form" />
        <field name="arch" type="xml">
            <field name="activity_id" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
        </field>
    </record>
    <record id="consent_list" model="ir.ui.view">
        <field name="name">Privacy Consent List: company</field>
        <field name="model">privacy.consent</field>
        <field name="inherit_id" ref="privacy_consent.consent_list" />
        <field name="arch" type="xml">
            <field name="activity_id" position="after">
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </field>
        </field>
    </record>
    <record id="consent_search" model="ir.ui.view">
        <field name="name">Privacy Consent Search: company</field>
        <field name="model">privacy.consent</field>
        <field name="inherit_id" ref="privacy_consent.consent_search" />
        <field name="arch" type="xml">
            <field name="activity_id" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
            <filter name="activity_id_groupby" position="before">
                <filter
                    name="company_id_groupby"
                    string="Company"
                    context="{'group_by': 'company_id'}"
                    groups="base.group_multi_company"
                />
            </filter>
        </field>
    </record>
</odoo>
